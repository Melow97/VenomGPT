{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "venomgp",
  "compatibility_date": "2026-08-15",
  "main": "worker.js",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
